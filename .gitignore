# ── Fuentes primarias ───────────────────────────────────────────
# Los PDFs viven solo en disco (488 MB). La trazabilidad se mantiene
# vía INVENTARIO.md y las notas de wiki/sources/.
raw/sources/
!raw/sources/.gitkeep

# ── Obsidian ────────────────────────────────────────────────────
# Se versiona la config del vault; no el estado de ventanas ni los
# binarios de plugins.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/
.obsidian/cache
.trash/

# El vault es la raiz del repositorio. Cualquier .obsidian/ anidado es un vault
# abierto por error sobre una subcarpeta: estado de editor, no configuracion.
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
wiki/.obsidian/

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Sistema ─────────────────────────────────────────────────────
desktop.ini
Thumbs.db
.DS_Store

# ── Respaldos ───────────────────────────────────────────────────
# Instantaneas comprimidas del vault. Se generan a mano y no se versionan:
# el historial de git ya es el respaldo con procedencia.
MagisterLeo-*.zip
